{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.event_id, m.sender_id,\n                  u.display_name AS sender_display_name,\n                  m.seq, m.body, m.created_at\n           FROM messages m\n           JOIN users u ON u.id = m.sender_id\n           WHERE m.event_id = $1 AND m.seq > $2\n           ORDER BY m.seq ASC\n           LIMIT $3",
