  "query": "UPDATE users SET\n             display_name    = COALESCE($2, display_name),\n             bio             = CASE WHEN $3 THEN $4 ELSE bio END,\n             avatar_media_id = COALESCE($5, avatar_media_id)\n           WHERE id = $1\n           RETURNING id, display_name, phone, is_guest, bio",
