{
  "db_name": "PostgreSQL",
  "query": "SELECT m.event_id, e.title AS event_title, m.seq, m.body, m.created_at\n           FROM messages m JOIN events e ON e.id = m.event_id\n           WHERE m.sender_id = $1 AND m.redacted_at IS NULL\n           ORDER BY m.created_at",
