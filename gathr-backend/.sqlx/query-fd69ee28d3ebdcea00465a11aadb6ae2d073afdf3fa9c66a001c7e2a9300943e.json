  "query": "SELECT h.user_id, u.display_name, h.role::text AS \"role!\", h.added_at\n           FROM event_hosts h\n           JOIN users u ON u.id = h.user_id\n           WHERE h.event_id = $1\n           ORDER BY h.role, h.added_at",
