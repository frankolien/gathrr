              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}"
              ]
            },
            "description": "Partial. Omit a field to leave it alone; send null to clear it. Capacity cannot drop below seats already taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Amara's 27th Birthday\",\n  \"location_name\": \"Lekki, Lagos\",\n  \"capacity\": 60\n}",
              "options": {
