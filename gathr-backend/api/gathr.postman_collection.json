            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Edit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
