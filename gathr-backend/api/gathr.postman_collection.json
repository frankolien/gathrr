{
  "info": {
    "name": "Gathr API",
    "description": "Gathr backend. Set {{baseUrl}}, then run Auth > Dev sign-in (or the OTP pair) to populate {{accessToken}}. Every mutating request needs an Idempotency-Key; the collection sends a fresh {{$guid}} for you.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "inviteCode",
      "value": ""
    },
    {
      "key": "email",
      "value": "amara@example.com"
    },
    {
      "key": "otpCode",
      "value": ""
    },
    {
      "key": "guestId",
      "value": ""
    },
    {
      "key": "mediaId",
      "value": ""
    },
    {
      "key": "publicId",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "apnsToken",
      "value": ""
    },
    {
      "key": "uploadUrl",
      "value": ""
    },
    {
      "key": "uploadApiKey",
      "value": ""
    },
    {
      "key": "uploadTimestamp",
      "value": ""
    },
    {
      "key": "uploadSignature",
      "value": ""
    },
    {
      "key": "uploadFolder",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness. No auth."
          }
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Readiness: 200 only when Postgres answers. 503 otherwise. Point your load balancer here, not /health."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dev sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/dev",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "dev"
              ]
            },
            "description": "Development only; requires GATHR_ALLOW_DEV_AUTH=true. Stores the token pair.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Amara Chukwu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "pm.test('signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request an OTP code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/otp/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "otp",
                "request"
              ]
            },
            "description": "Issues a 6-digit code. In a development build the code comes back in the body and is stored as {{otpCode}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"destination\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.development_code) { pm.collectionVariables.set('otpCode', body.development_code); }",
                  "pm.test('accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify an OTP code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/otp/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "otp",
                "verify"
              ]
            },
            "description": "Redeems the code and returns a token pair. Five wrong attempts lock the challenge.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"email\",\n  \"destination\": \"{{email}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "pm.test('signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Apple or Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/oauth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "oauth"
              ]
            },
            "description": "Verifies an OIDC ID token. Answers 503 provider_unavailable until GATHR_APPLE_AUDIENCES / GATHR_GOOGLE_AUDIENCES are set.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"apple\",\n  \"id_token\": \"<provider id token>\",\n  \"nonce\": \"<raw nonce>\",\n  \"display_name\": \"Amara Chukwu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the pair. Reusing a burnt token revokes the whole family.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "pm.test('signed in', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Rename me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Amara C.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes every refresh token this account holds, on every device."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create + publish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events"
              ]
            },
            "description": "Stores {{eventId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Amara's 26th Birthday\",\n  \"category\": \"birthday\",\n  \"description\": \"Small and loud.\",\n  \"location_name\": \"Victoria Island, Lagos\",\n  \"starts_at\": \"2027-09-08T18:00:00Z\",\n  \"timezone\": \"Africa/Lagos\",\n  \"capacity\": 40,\n  \"max_plus_ones\": 2,\n  \"publish_now\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('eventId', body.id);",
                  "pm.test('created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events?filter=hosting",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "hosting"
                }
              ]
            },
            "description": "filter is one of this_week, hosting, attending."
          }
        },
        {
          "name": "Detail",
          "request": {
