    {
      "name": "Invites",
      "item": [
        {
          "name": "Create an invite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "invites"
              ]
            },
            "description": "Stores {{inviteCode}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_uses\": 50,\n  \"expires_at\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('inviteCode', body.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "List invites",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "invites"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Resolve a code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/invites/{{inviteCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "invites",
                "{{inviteCode}}"
              ]
            },
            "description": "Unauthenticated. Rate limited to 20/min per caller \u2014 this is the enumeration surface."
          }
        },
        {
          "name": "Web invite page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/i/{{inviteCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "i",
                "{{inviteCode}}"
              ]
            },
            "description": "Server-rendered HTML with OG tags."
          }
        },
        {
          "name": "Web guest RSVP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/i/{{inviteCode}}/rsvp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "i",
                "{{inviteCode}}",
                "rsvp"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "going"
                },
                {
                  "key": "display_name",
                  "value": "Chidi Okonkwo"
                },
                {
                  "key": "plus_ones",
                  "value": "0"
                }
              ]
            },
            "description": "Form post from the server-rendered invite page. Creates a shadow user and a guest session cookie; no account needed."
          }
        }
      ]
    },
    {
      "name": "RSVPs",
      "item": [
        {
          "name": "Submit an RSVP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/rsvp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "rsvp"
              ]
            },
            "description": "status is going, maybe, declined or waitlisted. Set accept_waitlist to opt into the waitlist when full; otherwise a full event answers 409 capacity_exceeded.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"going\",\n  \"plus_ones\": 1,\n  \"accept_waitlist\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Guest list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/guests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "guests"
              ]
            },
            "description": "Host only. Reports going (people) and seats_taken (people + plus-ones) separately."
          }
        },
        {
          "name": "Promote from the waitlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/guests/{{guestId}}/promote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "guests",
                "{{guestId}}",
                "promote"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Remove a guest",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/guests/{{guestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "guests",
                "{{guestId}}"
              ]
            },
            "description": "Host only. Frees the guest's seats immediately."
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Post a message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "idempotency-key",
                "value": "{{$guid}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "messages"
              ]
            },
            "description": "Host or any guest with an RSVP. Allocates the next per-event seq and broadcasts to open sockets.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Doors at 7, come hungry\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Read the thread",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/messages?after_seq=0&limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "after_seq",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Paginate by seq: pass the latest_seq you have as after_seq."
          }
        },
        {
          "name": "Live stream (WebSocket)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "stream"
              ]
            },
            "description": "WebSocket upgrade. Postman: use a WebSocket request to ws://127.0.0.1:8080/v1/events/{{eventId}}/stream with the same Authorization header. Each new message arrives as one JSON text frame."
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Get an upload ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/media/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "media",
                "sign"
              ]
            },
            "description": "purpose is cover or avatar. Returns a Cloudinary signature; the API secret stays on the server. Stores the ticket fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"cover\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set('uploadUrl', t.upload_url);",
                  "pm.collectionVariables.set('uploadApiKey', t.api_key);",
                  "pm.collectionVariables.set('uploadTimestamp', t.timestamp);",
                  "pm.collectionVariables.set('uploadSignature', t.signature);",
                  "pm.collectionVariables.set('uploadFolder', t.folder);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload to Cloudinary",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{uploadUrl}}",
              "host": [
                "{{uploadUrl}}"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "api_key",
                  "value": "{{uploadApiKey}}"
                },
                {
                  "key": "timestamp",
                  "value": "{{uploadTimestamp}}"
                },
                {
                  "key": "folder",
                  "value": "{{uploadFolder}}"
                },
                {
                  "key": "signature",
                  "value": "{{uploadSignature}}"
                }
              ]
            },
            "description": "Goes straight to Cloudinary, not to Gathr. Pick a file, send, then copy public_id into the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.public_id) { pm.collectionVariables.set('publicId', body.public_id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Record the upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "media"
              ]
            },
            "description": "Tells Gathr about a file Cloudinary now holds. Stores {{mediaId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"public_id\": \"{{publicId}}\",\n  \"content_type\": \"image/jpeg\",\n  \"width\": 1200,\n  \"height\": 800\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('mediaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Attach it as the cover",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/cover/{{mediaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "cover",
                "{{mediaId}}"
              ]
            },
            "description": "Host only, and only for uploads you recorded. Returns the transformed delivery URL."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Activity feed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/notifications?limit=40",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notifications"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "40"
                },
                {
                  "key": "before",
                  "value": "2027-01-01T00:00:00Z",
                  "disabled": true
                }
              ]
            },
            "description": "Everything that happened to you, newest first, with the unread badge count."
          },
          "response": []
        },
        {
          "name": "Mark the feed read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/notifications/read",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "notifications",
                "read"
              ]
            },
            "description": "An empty ids array clears the whole badge; pass ids to clear just those lines."
          },
          "response": []
        },
        {
          "name": "Register this device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "devices"
              ]
            },
            "description": "Hex APNs token. Re-registering the same token keeps the same row. environment is sandbox or production.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apns_token\": \"{{apnsToken}}\",\n  \"environment\": \"sandbox\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('deviceId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forget this device",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/devices/{{deviceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "devices",
                "{{deviceId}}"
              ]
            },
            "description": "Only the account that registered it can remove it."
          }
        },
        {
          "name": "Mute an event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/mute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "events",
                "{{eventId}}",
                "mute"
              ]
            },
            "description": "Silences reminders for this event without unregistering the device. Send muted:false to undo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"muted\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
